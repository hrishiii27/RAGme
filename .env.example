VECTOR_STORE_TYPE=pinecone

# Pinecone Cloud Configuration (Free 2GB Serverless)
PINECONE_API_KEY=pcsk_6Ehsjg_NnNZ5nBTS5fMeZJ61XPb8m83Nq4hEDRuZPRF4UQUSYvF3q8gMPBVjo6yHth
